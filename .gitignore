# Local environment files
.env*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template
*.env

# Secret and credential files
**/secrets.*
**/credentials.*
**/*secret*
**/*credential*
**/*api_key*
**/*apikey*

# Private keys and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Local database files and SQLite journals
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm